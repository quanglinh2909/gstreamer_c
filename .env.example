# Tham số RIÊNG của từng máy. Copy file này thành .env rồi sửa:
#
#     cp .env.example .env
#     nano .env
#     pm2 restart test_gstreamer --update-env
#
# .env KHÔNG được copy sang máy khác — mỗi máy tự giữ bản của mình.
# Còn config/config.json là phần dùng chung, copy thoải mái giữa các máy.
#
# Bỏ trống hoặc comment (#) dòng nào thì dòng đó lấy giá trị trong config.json.
# Giá trị sai (port không phải số...) sẽ bị BỎ QUA kèm cảnh báo trong log,
# engine vẫn chạy bằng giá trị của config.json.
# Mỗi lần ghi đè engine in một dòng "[config] GS_... ghi de -> ..." lúc khởi
# động, nên xem `pm2 logs test_gstreamer` là biết máy đang chạy giá trị nào.

# ─── Thư mục chứa model .rknn (hay khác nhau nhất giữa các máy) ─────────
# GS_WEIGHTS_DIR=/home/orangepi/Documents/ai_gstreamer/weights

# ─── Cơ sở dữ liệu ─────────────────────────────────────────────────────
# Lưu ý: engine C++ dùng "postgresql://", KHÁC với backend Python dùng
# "postgresql+asyncpg://". Đừng dùng chung một chuỗi cho cả hai.
# GS_DATABASE_URL=postgresql://oryza:Oryza%40123@localhost:5433/parking

# ─── HTTP server ───────────────────────────────────────────────────────
# GS_SERVER_HOST=0.0.0.0
# GS_SERVER_PORT=8009

# ─── RTSP ──────────────────────────────────────────────────────────────
# publicRtspHost là IP/hostname mà MÁY KHÁC dùng để xem luồng, nên gần như
# luôn phải đổi theo IP thật của từng máy.
# GS_PUBLIC_RTSP_HOST=192.168.104.9
# GS_RTSP_HOST=0.0.0.0
# GS_RTSP_PORT=8554

# ─── Ghi hình ──────────────────────────────────────────────────────────
# GS_RECORDING_ENABLED=false        # 1/0, true/false, yes/no, on/off
# GS_RECORDING_DIR=recordings

# ─── Phần cứng giải mã: auto | mpp | soft ──────────────────────────────
# GS_DEFAULT_HARDWARE=auto
